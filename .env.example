# Dashboard environment template. Copy to `.env.local` (development) or
# `.env.staging` (staging build) and fill in real values.
#
# NEVER commit a file containing real values. `.env*` is gitignored — the
# previously tracked `.env.staging` carried a live Google Maps browser key,
# which is why these are templated now.
#
# Vite inlines every VITE_* variable into the built JavaScript bundle. They
# are therefore public by definition: restrict them at the provider (HTTP
# referrer + API restrictions in Google Cloud), never rely on secrecy.

# One of: local | staging | production
VITE_ENVIRONMENT=local

# Base URL of the Alarm System API, no trailing slash.
# Required — the app throws at startup if this is unset (see src/config.ts).
VITE_API_URL=http://localhost:3000

# Google Maps JavaScript API browser key.
# Restrict to the dashboard's own domains and to the Maps JavaScript +
# Geocoding APIs only.
VITE_GOOGLE_MAPS_API_KEY=replace-me

# Google Maps vector map style id used by AdvancedMarker.
VITE_GOOGLE_MAPS_MAP_ID=replace-me

# Optional: local development only. When set, the Vite dev server proxies
# /api and /socket.io to this origin so cookies work over localhost.
# VITE_API_PROXY_TARGET=https://wakil-alarm-api.fazilabs.com
